{
  "name": "angular-monnify-workspace",
  "version": "2.0.2",
  "private": true,
  "description": "Workspace for the angular-monnify library and its Ionic demo app.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "node scripts/copy-artifacts && ng build angular-monnify",
    "test": "ng test angular-monnify",
    "test:ci": "ng test angular-monnify --watch=false --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint",
    "pack:lib": "npm run build:lib && npm pack ./dist/angular-monnify --pack-destination ./dist"
  },
  "dependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@angular/router": "~20.3.33",
    "@ionic/angular": "^8.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.20.0",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.0",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "~20.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0"
  },
  "author": {
    "name": "Dansteve Adekanbi",
    "email": "danstevea@gmail.com",
    "url": "https://dansteve.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dansteve/angular-monnify.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Dansteve/angular-monnify/issues"
  },
  "homepage": "https://github.com/Dansteve/angular-monnify#readme",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
